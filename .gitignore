# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── عدة الجذر (تبعية واحدة: z-ai-web-dev-sdk لأداة scripts/vlm-check.ts) ──
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
prompt

# ملاحظة: كان النمط السابق `test` (اسم مجرد) يتجاهل أي مجلد اسمه test في
# كامل المستودع — بما فيه mobile_app/test/ — ففُقدت 77 اختباراً كاملة عند
# استعادة المستودع. استُبدل بمسار جذر الموقع فقط.
/dist/test

server.log

# ── مخرجات بناء لا تُودَع في git (R21 — قرار المالك) ──
# مخرجات بناء Flutter Web: تُمحى مع كل إقلاع (خارج repo.tar) ويعيد بناءها
# flutter-env/keeper.sh تلقائياً — أو يدوياً بسكربت scripts/build-flutter-web.sh
/public/mobile_app/
# حزم APK: مكانها GitHub Releases (يرفقها CI مع كل tag v*)
/public/downloads/
# مهارات الوكيل: تُمحى عند الإقلاع ويعيد keeper.sh استعادتها من docs/skills/
/skills/
# قاعدة بيانات محلية — لا سيرفر قاعدة في المشروع بعد إخراج Next.js/Prisma
/db/

# مخلفات التشغيل (R18-D1): نتائج أدوات الوكيل وذاكرة بايثون — أي مكان
tool-results/
__pycache__/

# pid عابرة من الإقلاع
.zscripts/dev.pid

# ── مخلفات بناء Flutter المحلية (R22 — لم تكن مغطاة قبل) ──
# أدوات flutter تولّدها داخل mobile_app — لا تُودَع أبداً (AGENTS.md §8)
/mobile_app/.dart_tool/
/mobile_app/build/
/mobile_app/.flutter-plugins
/mobile_app/.flutter-plugins-dependencies

# ── إضافات جذر الـsandbox (R22): مجلدات منصة/جلسة خارج شجرة المشروع ──
# ملفات المستخدم المؤقتة والنسخ الاحتياطية الكبيرة — تبقى على القرص لا في git
/upload/
/download/
# مستودع العمل الكنسي (استنساخ finacc-flutter2 الذي تُزامن منه الجذر)
/repo-review/
# بقايا جلسات تحقق سابقة إن ظهرت
/verify-public-mobile/
